{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "description": "Describe a candidate and keep the original record of its producer.\n\nAttributes\n----------\ncandidate_id : str\n    ID of the candidate, unique inside its bundle\ntarget_id : str\n    Target the candidate belongs to\nlabel : str\n    Name shown in the candidate list\nmetrics : list[Metric]\n    Scores supplied by the producer\nraw_record : dict\n    Untouched record as the producer wrote it",
      "properties": {
        "candidate_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Target Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "maxItems": 20,
          "title": "Metrics",
          "type": "array"
        },
        "raw_record": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Raw Record",
          "type": "object"
        }
      },
      "required": [
        "candidate_id",
        "target_id",
        "label",
        "metrics",
        "raw_record"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateKey": {
      "additionalProperties": false,
      "description": "Identify a candidate by the bundle ID and candidate ID.",
      "properties": {
        "bundle_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "candidate_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "candidate_id"
      ],
      "title": "CandidateKey",
      "type": "object"
    },
    "Collection": {
      "additionalProperties": false,
      "description": "Group the decisions belonging to one request revision.",
      "properties": {
        "collection_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Collection Id",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Revision Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "memberships": {
          "items": {
            "$ref": "#/$defs/Membership"
          },
          "maxItems": 1000,
          "title": "Memberships",
          "type": "array"
        }
      },
      "required": [
        "collection_id",
        "revision_id",
        "name",
        "memberships"
      ],
      "title": "Collection",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "description": "Record an external file or resource, it is never downloaded.",
      "properties": {
        "uri": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "description"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "EvidenceBundle": {
      "additionalProperties": false,
      "description": "Group candidates with the request context their producer used.\n\nAttributes\n----------\nbundle_id : str\n    UUID of the bundle\nrequest_id : str\n    Request the bundle was produced for\ncontext : Revision\n    Exact revision the producer received\ncategory : str\n    synthetic or computational_prediction\nsource : Source\n    Who produced the bundle\ncandidates : list[Candidate]\n    Candidates of the bundle\ndependencies : list[Dependency]\n    External resources the producer refers to",
      "properties": {
        "kind": {
          "const": "evidence",
          "default": "evidence",
          "title": "Kind",
          "type": "string"
        },
        "format_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Format Version",
          "type": "string"
        },
        "bundle_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/Revision"
        },
        "category": {
          "enum": [
            "synthetic",
            "computational_prediction"
          ],
          "title": "Category",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "maxItems": 200,
          "title": "Candidates",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "maxItems": 100,
          "title": "Dependencies",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "format_version",
        "bundle_id",
        "request_id",
        "context",
        "category",
        "source",
        "candidates",
        "dependencies"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "JsonValue": {},
    "Membership": {
      "additionalProperties": false,
      "description": "Store the decision about one candidate in one collection.\n\nAttributes\n----------\ncandidate : CandidateKey\n    The candidate the decision is about\ndisposition : str\n    The decision itself\nrationale : str\n    Why the decision was made\nevidence_refs : list[CandidateKey]\n    Other candidates supporting the decision",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/CandidateKey"
        },
        "disposition": {
          "enum": [
            "undecided",
            "include_for_review",
            "exclude",
            "needs_clarification"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/CandidateKey"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "candidate",
        "disposition",
        "rationale",
        "evidence_refs"
      ],
      "title": "Membership",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "Store one score together with its meaning and availability.\n\nZero and a missing value are different things here, the availability\nsays which one it is.",
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "scale": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scale"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "higher",
                "lower",
                "not_ordered"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Direction"
        },
        "availability": {
          "enum": [
            "present",
            "not_supplied",
            "unsupported",
            "failed",
            "unknown"
          ],
          "title": "Availability",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "model",
        "unit",
        "scale",
        "direction",
        "availability",
        "value"
      ],
      "title": "Metric",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "present"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "RequestSnapshot": {
      "additionalProperties": false,
      "description": "Store one request revision in the local exchange format.\n\nAttributes\n----------\nstudy_id, request_id : str\n    Identity of the study the request comes from\ntitle : str\n    Title of the study\nrevision : Revision\n    The exported revision\ntarget_labels : dict[str, str]\n    Labels of the targets of the revision, keyed by target ID",
      "properties": {
        "kind": {
          "const": "request",
          "default": "request",
          "title": "Kind",
          "type": "string"
        },
        "format_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Format Version",
          "type": "string"
        },
        "study_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Study Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "revision": {
          "allOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "properties": {
                "targets": {
                  "minItems": 1
                }
              }
            }
          ]
        },
        "target_labels": {
          "patternProperties": {
            "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "title": "Target Labels",
          "type": "object",
          "maxProperties": 50
        }
      },
      "required": [
        "kind",
        "format_version",
        "study_id",
        "request_id",
        "title",
        "revision",
        "target_labels"
      ],
      "title": "RequestSnapshot",
      "type": "object"
    },
    "ReviewPackage": {
      "additionalProperties": false,
      "description": "Saved request, review decisions and the original evidence files.",
      "properties": {
        "kind": {
          "const": "review",
          "default": "review",
          "title": "Kind",
          "type": "string"
        },
        "format_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Format Version",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/RequestSnapshot"
        },
        "source_saved_version": {
          "minimum": 1,
          "title": "Source Saved Version",
          "type": "integer"
        },
        "collections": {
          "items": {
            "$ref": "#/$defs/Collection"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Collections",
          "type": "array"
        },
        "evidence_files": {
          "items": {
            "$ref": "#/$defs/ReviewSourceFile"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidence Files",
          "type": "array"
        },
        "review_status": {
          "enum": [
            "draft",
            "reviewed"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "unresolved_count": {
          "maximum": 1020,
          "minimum": 0,
          "title": "Unresolved Count",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "format_version",
        "request",
        "source_saved_version",
        "collections",
        "evidence_files",
        "review_status",
        "unresolved_count"
      ],
      "title": "ReviewPackage",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "unresolved_count": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "review_status": {
                "const": "reviewed"
              }
            }
          },
          "else": {
            "properties": {
              "review_status": {
                "const": "draft"
              }
            }
          }
        }
      ]
    },
    "ReviewSourceFile": {
      "additionalProperties": false,
      "description": "Original evidence bytes included in a review download.",
      "properties": {
        "bundle_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "content_base64": {
          "maxLength": 1398104,
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "title": "Content Base64",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "sha256",
        "content_base64"
      ],
      "title": "ReviewSourceFile",
      "type": "object"
    },
    "Revision": {
      "additionalProperties": false,
      "description": "Keep the reference and targets of one request revision.\n\nAttributes\n----------\nrevision_id : str\n    UUID of the revision\nreference_id : str\n    Catalogue ID of the reference\nprofile_id : str\n    Catalogue ID of the analysis profile\ncoordinate_system : str\n    Always 0-based-half-open\ntargets : list[Target]\n    Accepted targets of this revision",
      "properties": {
        "revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Revision Id",
          "type": "string"
        },
        "reference_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reference Id",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Profile Id",
          "type": "string"
        },
        "coordinate_system": {
          "const": "0-based-half-open",
          "default": "0-based-half-open",
          "title": "Coordinate System",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "maxItems": 50,
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "revision_id",
        "reference_id",
        "profile_id",
        "coordinate_system",
        "targets"
      ],
      "title": "Revision",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Describe the producer declared in the evidence file.",
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uri"
        }
      },
      "required": [
        "name",
        "version",
        "uri"
      ],
      "title": "Source",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "description": "Store one target interval on an exact contig accession.\n\nAttributes\n----------\ntarget_id : str\n    UUID of the target, stays the same through revisions\ncontig : str\n    Accession of the contig (for example NC_000001.11)\nstart : int\n    First base of the interval, 0-based\nend : int\n    End of the interval, exclusive\nstrand : str\n    +, - or . when not specified",
      "properties": {
        "target_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Target Id",
          "type": "string"
        },
        "contig": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Contig",
          "type": "string"
        },
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "strand": {
          "enum": [
            "+",
            "-",
            "."
          ],
          "title": "Strand",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "contig",
        "start",
        "end",
        "strand"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/RequestSnapshot"
    },
    {
      "$ref": "#/$defs/EvidenceBundle"
    },
    {
      "$ref": "#/$defs/ReviewPackage"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viridisquercus.github.io/IRCOMP-GUI/contracts/exchange-1.0.schema.json",
  "title": "IRCOMP-GUI local exchange 1.0",
  "description": "Generated from the Python models. Domain rules also apply."
}
